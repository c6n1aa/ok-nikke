msgstr "選択したフォルダーのパスを保存する設定。"

msgid "带可选文件过滤器的文件选择配置。"
msgstr "任意指定のファイルフィルター付きファイル選択設定。"

msgid "仅可从已翻译可用值中选择的下拉框选项配置。"
msgstr "翻訳済みの利用可能な値のみ選べるドロップダウン候補設定。"

msgid "显示全部当前配置值的按钮配置。"
msgstr "現在のすべての設定値を表示するボタン設定。"

msgid "带多个操作按钮的按钮配置。"
msgstr "複数のアクションボタンを持つボタン設定。"

msgid "请从可用下拉框值中选择。"
msgstr "利用可能なドロップダウン値から選択してください。"

msgid "请仅选择可用的多选值。"
msgstr "利用可能な複数選択値のみ選択してください。"

msgid "请仅选择可用的下拉框选项值。"
msgstr "利用可能なドロップダウン候補値のみ選択してください。"

msgid "已显示全部配置值。"
msgstr "設定値をすべて表示しました。"

msgid "已显示按钮通知。"
msgstr "ボタン通知を表示しました。"

