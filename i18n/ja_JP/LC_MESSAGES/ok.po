msgstr "通常は frame の内容で実行するかどうかを判断します。"

# HarvestTask
msgid "收获"
msgstr "収穫"

msgid "收取友情点与邮箱奖励。"
msgstr "友情ポイントとメールボックスの報酬を受け取ります。"

msgid "收获友情点"
msgstr "友情ポイント収穫"

msgid "收取邮箱"
msgstr "メールボックス受け取り"

msgid "是否点击好友送礼并收取友情点。"
msgstr "友達へのギフト送信と友情ポイントの受け取りを行うかどうか。"

msgid "是否收取邮箱中的奖励。"
msgstr "メールボックス内の報酬を受け取るかどうか。"

# OutpostDefenseTask
msgid "歼灭"
msgstr "一掃"

msgid "防御前哨基地进行收菜，可选使用珠宝追加次数。"
msgstr "前哨基地を防衛して報酬を受け取り、必要に応じてジェムで回数を追加します。"

msgid "使用珠宝歼灭次数"
msgstr "ジェム一掃回数"

msgid "使用珠宝进行一举歼灭的次数，0-10，0表示仅使用免费次数。"
msgstr "ジェムを使って一掃する回数（0-10）。0の場合は無料回数のみ使用します。"

msgid "使用珠宝歼灭次数必须在 0 到 10 之间。"
msgstr "ジェム一掃回数は 0 から 10 の間で指定してください。"

# CashShopTask
msgid "付费商店"
msgstr "キャッシュショップ"

msgid "自动领取付费商店中STEP UP/每日/每周/每月的免费礼包。"
msgstr "キャッシュショップの無料パック（STEP UP／毎日／毎週／毎月）を自動で受け取ります。"
