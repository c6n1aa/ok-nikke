# HarvestTask
msgid "收获"
msgstr "收穫"

msgid "收取友情点与邮箱奖励。"
msgstr "收取友情點與信箱獎勵。"

msgid "收获友情点"
msgstr "收穫友情點"

msgid "收取邮箱"
msgstr "收取信箱"

