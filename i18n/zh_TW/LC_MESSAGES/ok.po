msgstr "是否點擊好友送禮並收取友情點。"

msgid "是否收取邮箱中的奖励。"
msgstr "是否收取信箱中的獎勵。"

# OutpostDefenseTask
msgid "歼灭"
msgstr "殲滅"

msgid "防御前哨基地进行收菜，可选使用珠宝追加次数。"
msgstr "防禦前哨基地進行收菜，可選使用珠寶追加次數。"

msgid "使用珠宝歼灭次数"
msgstr "使用珠寶殲滅次數"

msgid "使用珠宝进行一举歼灭的次数，0-10，0表示仅使用免费次数。"
msgstr "使用珠寶進行一舉殲滅的次數，0-10，0表示僅使用免費次數。"

msgid "使用珠宝歼灭次数必须在 0 到 10 之间。"
msgstr "使用珠寶殲滅次數必須在 0 到 10 之間。"
