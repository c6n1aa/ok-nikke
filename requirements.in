# PySide6-Fluent-Widgets declares the full PySide6 metapackage, but this app
# only uses Qt modules shipped by Essentials. Install the compiled lock with
# --no-deps so pip does not restore PySide6-Addons transitively. After running
# pip-compile, remove its generated pyside6 and pyside6-addons entries again.
pyside6-essentials
pyside6-fluent-widgets
